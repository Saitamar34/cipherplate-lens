{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CipherPlate Lens",
  "version": "1.0.0",
  "identifier": "com.cipherplate.opticalbridge",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CipherPlate Lens · Relais Optique Sécurisé",
        "width": 420,
        "height": 780,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "iOS": {
      "infoPlist": "./Info.plist"
    }
  }
}
